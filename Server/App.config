<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<system.serviceModel>
		<services>
			<service name="Server.Services.EegService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8080" />
					</baseAddresses>
				</host>
				<endpoint
                    address="EegService"
                    binding="netTcpBinding"
                    contract="Shared.Contracts.IEegService" />
			</service>
		</services>
		
		
		
	</system.serviceModel>
</configuration>