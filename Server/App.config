<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<system.serviceModel>
		<services>
			<service name="Server.Services.EegService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8080" />
					</baseAddresses>
				</host>
				<endpoint
                    address="EegService"
                    binding="netTcpBinding"
					bindingConfiguration="EegBinding"
                    contract="Shared.Contracts.IEegService" />
			</service>
		</services>

		<bindings>
			<netTcpBinding>
				<binding name="EegBinding"
                         transferMode="Streamed"
                         maxReceivedMessageSize="10485760"
                         sendTimeout="00:10:00"
                         receiveTimeout="00:10:00">
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>

		
		
	</system.serviceModel>
	<appSettings>
		<add key="DataPath" value="Data" />
		<add key="BatteryLowThreshold" value="20" />
		<add key="ContactQualityMin" value="30" />
		<add key="StressSpikeThreshold" value="0.2" />
		<add key="ChannelOutOfBandPct" value="25" />
		<add key="TimestampSkewMaxMs" value="2000" />
	</appSettings>
</configuration>